generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Panel access + roles — managed from Supabase (public.AdminUser) or Admin → Admins.
// role: "owner" (full access incl. managing admins) | "admin" (panel access, no admin management)
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Product {
  id                String   @id @default(cuid())
  sku               String?  @unique
  name              String
  category          String   // rings | earrings | pendants | bracelets | bangles | necklaces
  description       String
  baseMetal         String   // gold | silver | brass
  purityOptions     String[] // e.g. ["14K","18K"] or ["925"]
  metalColorOptions String[] // e.g. ["Yellow Gold","White Gold","Rose Gold"]
  availableStones   String[] // e.g. ["Diamond","Ruby","None"]
  primaryGemstone   String?
  images            String[] // R2 keys resolved via getR2AssetUrl()
  featured          Boolean  @default(false)
  weightGrams       Float?
  makingChargeC     Float    @default(0) // per-product labour override (L), USD/g; 0 = use global labourCostPerGram
  gemstoneCount     Int      @default(1) // N in formula: number of gemstones per piece
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ClientAccount {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  company       String
  country       String
  phone         String?
  businessType  String   // Retailer | Wholesaler | Designer | Other
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionNote String?
  approvalToken String?  @unique // one-click email approval token
  supabaseUid   String?  @unique // linked Supabase Auth user id
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  type      String   // INQUIRY | QUOTATION
  name      String
  email     String
  company   String?
  phone     String?
  message   String?
  status    String   @default("NEW") // NEW | VIEWED | HANDLED
  createdAt DateTime @default(now())
}

model Certificate {
  id          String  @id
  name        String
  issuingBody String
  imageKey    String  // R2 key, resolved via getR2AssetUrl()
  validity    String?
  sortOrder   Int     @default(0)
}

// Stone cost values used in pricing formula: N*(s+st)
model StonePrice {
  id         String @id @default(cuid())
  stoneName  String @unique  // "Diamond" | "Ruby" | "None" etc.
  priceD     Float  @default(0) // s  — stone cost USD per piece
  satinCost  Float  @default(0) // st — satin/setting cost USD per piece (editable per stone type)
}

// Key-value store for admin-controlled site settings
model SiteSettings {
  key   String @id
  value String
  // Pricing formula keys (P = w*m*wastageFactor + N*(s+st) + L*w + platingFactor*w*m):
  //   wastageFactor         — metal wastage multiplier, e.g. "1.07"
  //   labourCostPerGram     — L, global labour cost USD/g, e.g. "0.50"
  //   platingCostFactor     — dimensionless plating factor P, e.g. "0.05"
  //   exchangeRateUSDtoINR  — e.g. "83.5"
  // Display keys:
  //   showPricingToClients  — "true" | "false"
  //   defaultCurrency       — "USD" | "INR"
  //   showCurrencyToggle    — "true" | "false"
}

// Website-builder: admin-created pages (e.g. /sustainability, /services)
// NOTE: tables already exist in production DB (CmsPage / CmsSection) — names kept in sync.
model CmsPage {
  id              String       @id @default(cuid())
  slug            String       @unique // URL: /<slug>
  title           String
  navLabel        String?
  showInNav       Boolean      @default(false)
  navOrder        Int          @default(0)
  status          String       @default("DRAFT") // DRAFT | PUBLISHED
  metaDescription String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  sections        CmsSection[]
}

// Website-builder: ordered content blocks inside a CmsPage
model CmsSection {
  id        String   @id @default(cuid())
  pageId    String
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   // hero | text_image | cards | stats | gallery | testimonials | cta
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  props     Json     @default("{}") // { heading, subheading, text, image, buttons, items... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, sortOrder])
}
